# Copy to `.env` (git-ignored) and restart the dev server — Expo inlines
# EXPO_PUBLIC_* variables at bundle time, so a running Metro will not pick up edits.

# Base URL of the agent control API. Leave unset and the app works it out:
#   web / iOS simulator  -> http://localhost:8000
#   Android emulator     -> http://10.0.2.2:8000
#   physical device      -> http://<your Metro LAN IP>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# TEMPORARY: serve dummy agents instead of calling GET /v1/agents, so the roster
# and the detail screen can be looked at without a server running. Set to 1 to
# turn it on. Fixtures and removal notes: src/api/fixtures/agents.ts. Only the
# roster is mocked — for a working conversation, run `npm run mock:api`.
# EXPO_PUBLIC_MOCK_AGENTS=1

# Optional bearer token, sent as `Authorization: Bearer <token>`.
# Only a placeholder for local work — for real secrets use SecureStore and
# `setAuthTokenProvider()` in src/api/client.ts, since EXPO_PUBLIC_* values are
# embedded in the JS bundle and are readable by anyone with the app.
# EXPO_PUBLIC_API_TOKEN=
