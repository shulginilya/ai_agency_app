        <mxCell id="t147" value="Three tabs, registered in that order in app/(tabs)/_layout.tsx. Agents is the landing route." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="900" height="24" as="geometry"/></mxCell>
