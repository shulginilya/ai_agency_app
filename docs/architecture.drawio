        <mxCell id="b153" value="agent/[id].tsx → src/screens/AgentDetail.tsx
pushed, not a tab" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="100" y="620" width="320" height="55" as="geometry"/></mxCell>
        <mxCell id="b154" value="+not-found.tsx" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1270" y="320" width="200" height="55" as="geometry"/></mxCell>
        <mxCell id="b155" value="The subagent roster, read-only — because the API is.
Row per agent: status pill, model, tools, turn cap,
and whether it loads on every run or only a team run.
Grouped by the teams teamsFromRoster() derives.

useAgents({ pollIntervalMs: 5 000 })" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="415" width="320" height="155" as="geometry"/></mxCell>
        <mxCell id="b156" value="Sends work. Mode switch: multi-turn session, or
one-shot run. Team and profile pickers — disabled
once a session exists, because the server fixes
both at open time.
Each reply carries its cost, tool trace and delegation.

useConversation({ mode, profile, team }) · useTeams()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="415" width="380" height="155" as="geometry"/></mxCell>
        <mxCell id="b157" value="/healthz and /readyz, re-run every 10 s while on screen.
Free run and session slots, parsed with
ReadinessSchema.safeParse at render — the strip is
omitted rather than crashing if the shape moved.
Every open session, with a close button.
The last 50 requests the app made.

useSystemStatus() · useSessions() · useCloseSession()
useRequestLog()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="415" width="340" height="175" as="geometry"/></mxCell>
        <mxCell id="b158" value="One roster entry in full. useAgent(id) seeds from the
list cache, so the push is instant.
Exports STATUS_TONE, which the roster reuses." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="690" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="e159" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#8c8c8c;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b148" target="b149"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e160" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#8c8c8c;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b149" target="b150"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e161" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#8c8c8c;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b149" target="b151"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e162" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#8c8c8c;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b149" target="b152"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e163" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#8c8c8c;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="b150" target="b155"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e164" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#8c8c8c;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="b151" target="b156"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e165" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#8c8c8c;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="b152" target="b157"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e166" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#8c8c8c;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="b153" target="b158"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e167" value="tap a row → router.push(&quot;/agent/{id}&quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#8c8c8c;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b155" target="b153"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e168" value="unmatched route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#8c8c8c;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="b148" target="b154"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t169" value="Convention: full screens live in src/screens/ so a test can render them without a router;
route files are thin wrappers, excluded from coverage. jest.setup.ts mocks expo-router globally.
control-plane.tsx never got extracted — it predates the convention — so its test imports the route module." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="460" y="620" width="760" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="d209" name="4 · Tests, tooling, contract">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="band170" value="npm test   —   jest-expo + React Native Testing Library, no network" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f3fb;strokeColor=#d9d9d9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#8a8a8a;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="800" height="420" as="geometry"/></mxCell>
        <mxCell id="band171" value="npm run e2e   —   Cypress against the real web build" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f7fb;strokeColor=#d9d9d9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#8a8a8a;" vertex="1" parent="1"><mxGeometry x="850" y="40" width="830" height="420" as="geometry"/></mxCell>
        <mxCell id="band172" value="the contract check   —   neither side generates the other" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf3f3;strokeColor=#d9d9d9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#8a8a8a;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="1660" height="380" as="geometry"/></mxCell>
        <mxCell id="b173" value="src/**/__tests__  ·  __tests__/*-screen.test.tsx
http · sessions · transcript · hooks · screens" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="45" y="85" width="350" height="60" as="geometry"/></mxCell>
        <mxCell id="b174" value="src/test-utils/
http.ts fetch doubles · fixtures.ts wire-shaped factories
render.tsx (wraps in a QueryClientProvider)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="45" y="165" width="350" height="70" as="geometry"/></mxCell>
        <mxCell id="b175" value="jest.setup.ts
mocks expo-router globally, so screens that
navigate render without a navigation container" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="45" y="255" width="350" height="65" as="geometry"/></mxCell>
        <mxCell id="b176" value="coverage thresholds
global 85 / 80 / 80 / 85, plus a higher floor on
http.ts · system.ts · sessions.ts · chat/transcript.ts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b3b3b3;dashed=1;" vertex="1" parent="1"><mxGeometry x="45" y="340" width="350" height="70" as="geometry"/></mxCell>
        <mxCell id="t177" value="Gotchas: RNTL v13 has no toHaveAccessibilityState — use
toBeDisabled/toBeEnabled. toHaveTextContent is an exact match;
pass a regex for substrings. In a Linux container, --forceExit.
_to_delete/ is ignored by jest and tsconfig alike." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="t178" value="212 tests as of the 2026-08-21 rebuild.

npx jest over the device bridge exceeds the
45 s cap and returns nothing — copy the repo
into a container and run it there instead." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="420" y="250" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="b179" value="expo start --web  :8081
react-native-web — testID becomes data-testid,
so the same selectors work in jest and here" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="875" y="85" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="b180" value="cypress/e2e/
agents · conversation · control-plane" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="875" y="175" width="360" height="55" as="geometry"/></mxCell>
        <mxCell id="b181" value="tools/mock-agent-api.mjs  :8000
serves exactly the spec’d surface,
RFC 9457 problem bodies" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="875" y="250" width="360" height="65" as="geometry"/></mxCell>
        <mxCell id="b182" value="POST /__control__
readyz: fail · runs: busy | fail | error | timeout
sessions: busy · replyDelayMs · latencyMs · reset
→ the degraded, offline and slow paths, on demand" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b3b3b3;dashed=1;" vertex="1" parent="1"><mxGeometry x="875" y="330" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="t183" value="start-server-and-test boots the mock, waits for
/healthz, boots Expo web, waits for :8081,
then runs Cypress. No FastAPI process required.

npm run verify = typecheck + coverage + e2e
— what CI should run." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="1260" y="90" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="b184" value="the FastAPI repo
hand-written Pydantic models" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="60" y="545" width="300" height="55" as="geometry"/></mxCell>
        <mxCell id="b185" value="contracts/python/export_openapi.py --check
fails the build when a model changes without
the spec change being committed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="b186" value="contracts/openapi.json
the pinned spec — keys sorted, one trailing newline,
so a no-op refresh is an empty diff" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="430" y="630" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="b187" value="tools/pull-openapi.mjs
npm run contract:pull        refresh it
npm run contract:pull -- --check   is it stale?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="430" y="545" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="b188" value="src/api/__tests__/contract.test.ts
CONTRACT: every response the app parses, pointed
at its leaf schema. Reads the pinned file — no network,
no running API." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="860" y="630" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="b189" value="src/api/contract.ts — checkContract()
Compares through JSON Schema (z.toJSONSchema).
Asymmetric on purpose: the question is never
&quot;are these identical&quot; but &quot;can the server send
something this app would refuse?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="860" y="730" width="380" height="95" as="geometry"/></mxCell>
        <mxCell id="b190" value="error — fails the build
server may send null, client rejects it ·
required field the server may omit ·
type mismatch · client stricter minLength/format ·
server enum value the client rejects" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1290" y="630" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="b191" value="info — reported, tolerated
server sends a field the client ignores ·
client handles a value the server never sends ·
unions, compared shallowly" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1290" y="745" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="t192" value="Why not codegen? Either side could generate the other — and then one side stops being hand-written, and the comments in schemas.ts
explaining why a field is loose are exactly what a generator throws away. So both stay hand-written and this fails the build when they disagree." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="60" y="730" width="760" height="60" as="geometry"/></mxCell>
        <mxCell id="e193" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#8c8c8c;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b184" target="b185"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e194" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#8c8c8c;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b185" target="b186"><mxGeometry relative="1" as="geometry"/></mxCell>
