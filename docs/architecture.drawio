Stack · SafeAreaProvider · QueryProvider · StatusBar" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="380" height="60" as="geometry"/></mxCell>
