{
  "name": "ai-agency-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "tunnel": "expo start --tunnel",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress/tsconfig.json",
    "doctor": "npx expo-doctor",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "mock:api": "node tools/mock-agent-api.mjs",
    "web:e2e": "expo start --web --port 8081",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "e2e": "start-server-and-test mock:api http-get://localhost:8000/healthz e2e:app",
    "e2e:app": "start-server-and-test web:e2e http-get://localhost:8081 cypress:run",
    "e2e:open": "start-server-and-test mock:api http-get://localhost:8000/healthz e2e:app:open",
    "e2e:app:open": "start-server-and-test web:e2e http-get://localhost:8081 cypress:open",
    "verify": "npm run typecheck && npm run test:coverage && npm run e2e"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "cypress": "^15.20.1",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "^19.1.0",
    "start-server-and-test": "^2.1.5",
    "typescript": "~5.9.2"
  }
}
